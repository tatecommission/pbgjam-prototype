install.packages("rvest")
# =============================================================================
# pull_timber_market_reports.R
# Downloads the Penn State Extension "Pennsylvania Timber Market Report" for the
# last N quarters and saves the price tables as two tidy CSV files.
#
# Outputs (written to OUT_DIR):
#   timber_stumpage_prices.csv  - $/MBF (International 1/4") by quarter, region, species
#   timber_pulpwood_prices.csv  - $/ton by quarter, seller (private / Bureau of Forestry),
#                                 product (hardwood / softwood), region
#   timber_pull_log.csv         - which quarters were found / which URL worked / row counts
#
# Needs: tidyverse and rvest (install.packages("rvest") if missing).
# Be polite to the server: the script waits between requests.
# =============================================================================
library(tidyverse)
library(rvest)
library(xml2)
# ── Settings ─────────────────────────────────────────────────────────────────
END_YEAR   <- 2026      # most recent report to pull
END_QTR    <- 2         # ...and its quarter (Q2 2026 = April-June 2026)
N_QUARTERS <- 20        # 20 quarters = 5 years
OUT_DIR    <- "."
PAUSE_SEC  <- 1.5
BASE <- "https://extension.psu.edu/"
# ── Quarters to pull (newest first) ──────────────────────────────────────────
qtrs <- tibble(i = 0:(N_QUARTERS - 1)) |>
mutate(idx  = END_YEAR * 4 + (END_QTR - 1) - i,
year = idx %/% 4,
qtr  = idx %% 4 + 1) |>
select(year, qtr)
ord_word <- c("first", "second", "third", "fourth")
ord_num  <- c("1st", "2nd", "3rd", "4th")
months   <- c("January-March", "April-June", "July-September", "October-December")
# Penn State has used several URL spellings over the years; try them in order
candidate_urls <- function(year, qtr) {
paste0(BASE, c(
sprintf("pennsylvania-timber-market-report-%s-quarter-%d", ord_word[qtr], year),
sprintf("pennsylvania-timber-market-report-%s-quarter-%d", ord_num[qtr],  year),
sprintf("pennsylvania-timber-market-report-%d-%s-quarter", year, ord_num[qtr]),
sprintf("timber-market-report-%d-%s-quarter",              year, ord_num[qtr])
))
}
read_page <- function(url) {
tryCatch(read_html(url), error = function(e) NULL)
}
# ── Table helpers ────────────────────────────────────────────────────────────
num <- function(x) suppressWarnings(readr::parse_number(as.character(x)))   # "$1,049" -> 1049; "^", "*", "" -> NA
# Text that appears just before a table on the page, nearest first (headings / captions)
text_before <- function(node, n = 60) {
tx <- xml_text(xml_find_all(node, "preceding::text()[normalize-space()]"))
rev(tail(str_squish(tx), n))
}
nearest <- function(txt, pattern) {
hit <- txt[str_detect(txt, regex(pattern, ignore_case = TRUE))]
if (length(hit) == 0) NA_character_ else str_extract(hit[1], regex(pattern, ignore_case = TRUE))
}
std_species <- function(x) {
x <- str_squish(x)
case_when(
str_to_lower(x) == "yellow-poplar"    ~ "Yellow-poplar",
str_to_lower(x) == "misc. hardwoods"  ~ "Misc. Hardwoods",
TRUE ~ x
)
}
# Parse every table on one report page
parse_report <- function(page, year, qtr, url) {
nodes <- html_elements(page, "table")
stump <- list(); pulp <- list(); k_stump <- 0
region_order <- c("Northeast", "Southeast", "Northwest", "Southwest")
for (nd in nodes) {
tb <- tryCatch(html_table(nd, header = FALSE), error = function(e) NULL)
if (is.null(tb) || ncol(tb) < 5 || nrow(tb) < 2) next
tb <- tb[, 1:5]
names(tb) <- c("label", "c2", "c3", "c4", "n")
tb <- tb |> mutate(across(everything(), as.character)) |>
filter(!str_detect(label, regex("^(species by region|region)$", ignore_case = TRUE)))
labs <- str_to_lower(str_squish(tb$label))
if (any(str_detect(labs, "oak|maple|cherry"))) {                      # stumpage table
k_stump <- k_stump + 1
before  <- text_before(nd, 15)
region  <- nearest(before, "Northeast|Southeast|Northwest|Southwest")
if (is.na(region)) region <- region_order[min(k_stump, 4)]
stump[[length(stump) + 1]] <- tb |>
transmute(year = year, quarter = qtr, region = str_to_title(region),
species = std_species(label),
low_1sd = num(c2), avg = num(c3), high_1sd = num(c4), n = num(n))
} else if (any(labs %in% str_to_lower(region_order))) {               # pulpwood table
before  <- text_before(nd, 80)
product <- nearest(head(before, 14), "Hardwood|Softwood")
seller  <- nearest(before, "Bureau of Forestry|Private and Other Public")
pulp[[length(pulp) + 1]] <- tb |>
transmute(year = year, quarter = qtr,
seller  = if_else(str_detect(seller, regex("Bureau", ignore_case = TRUE)),
"Bureau of Forestry", "Private and other public"),
product = str_to_title(product),
region  = str_to_title(str_squish(label)),
low = num(c2), avg = num(c3), high = num(c4), n = num(n))
}
}
stump <- bind_rows(stump)
pulp  <- bind_rows(pulp)
# The site prints $0 where there is no usable value: n = 0 -> no data; $0 low/high with a
# single response -> range not reported
if (nrow(stump)) {
stump <- stump |>
mutate(no_range = low_1sd %in% 0 & high_1sd %in% 0,
across(c(low_1sd, avg, high_1sd), ~ if_else(n %in% 0, NA_real_, .x)),
low_1sd  = if_else(no_range, NA_real_, low_1sd),
high_1sd = if_else(no_range, NA_real_, high_1sd)) |>
select(-no_range)
}
list(stumpage = stump, pulpwood = pulp)
}
# ── Pull every quarter ───────────────────────────────────────────────────────
stump_all <- list(); pulp_all <- list(); log_rows <- list()
for (r in seq_len(nrow(qtrs))) {
yr <- qtrs$year[r]; q <- qtrs$qtr[r]
page <- NULL; used <- NA_character_
for (u in candidate_urls(yr, q)) {
page <- read_page(u)
Sys.sleep(PAUSE_SEC)
if (!is.null(page) && length(html_elements(page, "table")) > 0) { used <- u; break }
page <- NULL
}
if (is.null(page)) {
message(sprintf("%d Q%d: NOT FOUND", yr, q))
log_rows[[r]] <- tibble(year = yr, quarter = q, found = FALSE, url = NA_character_,
stumpage_rows = 0L, pulpwood_rows = 0L)
next
}
res <- parse_report(page, yr, q, used)
stump_all[[r]] <- res$stumpage
pulp_all[[r]]  <- res$pulpwood
message(sprintf("%d Q%d (%s): %d stumpage rows, %d pulpwood rows",
yr, q, months[q], nrow(res$stumpage), nrow(res$pulpwood)))
log_rows[[r]] <- tibble(year = yr, quarter = q, found = TRUE, url = used,
stumpage_rows = nrow(res$stumpage), pulpwood_rows = nrow(res$pulpwood))
}
stumpage <- bind_rows(stump_all) |>
mutate(period = months[quarter], unit = "$ per MBF, International 1/4\" rule") |>
select(year, quarter, period, region, species, low_1sd, avg, high_1sd, n, unit) |>
arrange(desc(year), desc(quarter), region, species)
pulpwood <- bind_rows(pulp_all) |>
mutate(period = months[quarter], unit = "$ per ton") |>
select(year, quarter, period, seller, product, region, low, avg, high, n, unit) |>
arrange(desc(year), desc(quarter), seller, product, region)
pull_log <- bind_rows(log_rows)
write_excel_csv(stumpage, file.path(OUT_DIR, "timber_stumpage_prices.csv"), na = "")
write_excel_csv(pulpwood, file.path(OUT_DIR, "timber_pulpwood_prices.csv"), na = "")
write_excel_csv(pull_log, file.path(OUT_DIR, "timber_pull_log.csv"),        na = "")
message(sprintf("\nQuarters found: %d of %d", sum(pull_log$found), nrow(pull_log)))
if (any(!pull_log$found))
message("Not found (check these URLs by hand): ",
paste(sprintf("%d Q%d", pull_log$year[!pull_log$found], pull_log$quarter[!pull_log$found]), collapse = ", "))
message("Stumpage rows: ", nrow(stumpage), "   Pulpwood rows: ", nrow(pulpwood))
message("Files written to ", normalizePath(OUT_DIR))
shiny::runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
shiny::runApp()
runApp()
runApp()
