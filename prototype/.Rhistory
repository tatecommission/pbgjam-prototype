private_key <- openssl::read_key(gsub("\\\\n", "\n", key$private_key))
# Fix: convert string to raw bytes before signing
signature <- jsonlite::base64_enc(
openssl::signature_create(
chartr("", "", sig_input) |> chartr("", "") |> (\(x) as.raw(utf8ToInt(x)))(),
hash = openssl::sha256,
key  = private_key
)
)
