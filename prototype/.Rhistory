install.packages(c("httr", "openssl"))
library(httr)
library(jsonlite)
library(openssl)
key <- jsonlite::read_json("gee-key.json")
now <- as.integer(Sys.time())
claim <- jsonlite::base64_enc(jsonlite::toJSON(list(
iss   = key$client_email,
scope = "https://www.googleapis.com/auth/earthengine",
aud   = "https://oauth2.googleapis.com/token",
iat   = now,
exp   = now + 3600L
), auto_unbox = TRUE))
header <- jsonlite::base64_enc('{"alg":"RS256","typ":"JWT"}')
sig_input   <- paste0(header, ".", claim)
private_key <- openssl::read_key(gsub("\\\\n", "\n", key$private_key))
signature   <- jsonlite::base64_enc(openssl::signature_create(
chartr("", "", sig_input),
hash = openssl::sha256,
key  = private_key
))
