))
))),
geometry = list(functionInvocationValue = list(functionName = "GeometryConstructors.Rectangle", arguments = list(
coordinates = list(constantValue = conus), geodesic = list(constantValue = FALSE))))
))),
bands = list(constantValue = list("b1")), min = list(constantValue = 0), max = list(constantValue = 30),
palette = list(constantValue = list("0A1F0A","2E6B2E","7DB87D","E8F4D0","FFFFFF"))
))
)))
map_resp <- httr::POST(
paste0("https://earthengine.googleapis.com/v1/projects/", key$project_id, "/maps"),
httr::add_headers(Authorization = paste("Bearer", token)),
body = jsonlite::toJSON(body, auto_unbox = TRUE),
httr::content_type_json()
)
cat("Status:", httr::status_code(map_resp), "\n")
result <- httr::content(map_resp)
print(result)
# If we got a map name, build and test the actual tile URL
if (!is.null(result$name)) {
tile_url <- paste0("https://earthengine.googleapis.com/v1/", result$name, "/tiles/4/2/5")
cat("\nTesting tile fetch at:\n", tile_url, "\n")
tile_resp <- httr::GET(tile_url, httr::add_headers(Authorization = paste("Bearer", token)))
cat("Tile fetch status:", httr::status_code(tile_resp), "\n")
}
