library(httr)
library(jsonlite)
library(openssl)
.gee_canopy_tile_url <- function(key_path) {
key <- jsonlite::read_json(key_path)
now <- as.integer(Sys.time())
header <- "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9"
claim  <- gsub("=", "", jsonlite::base64_enc(chartr("\n", " ", jsonlite::toJSON(list(
iss   = key$client_email,
scope = "https://www.googleapis.com/auth/earthengine",
aud   = "https://oauth2.googleapis.com/token",
iat   = now,
exp   = now + 3600L
), auto_unbox = TRUE))))
sig_input   <- paste0(header, ".", claim)
private_key <- openssl::read_key(gsub("\\\\n", "\n", key$private_key))
signature   <- gsub("=", "", gsub("[+]", "-", gsub("/", "_",
jsonlite::base64_enc(
openssl::signature_create(charToRaw(sig_input), hash=openssl::sha256, key=private_key)
)
)))
jwt <- paste0(sig_input, ".", signature)
token <- httr::content(httr::POST(
"https://oauth2.googleapis.com/token",
body   = list(grant_type = "urn:ietf:params:oauth:grant-type:jwt-bearer",
assertion  = jwt),
encode = "form"
))$access_token
conus <- list(-125, 24, -66, 50)
body  <- list(
expression = list(
result = "0",
values = list(`0` = list(
functionInvocationValue = list(
functionName = "Image.visualize",
arguments = list(
input = list(functionInvocationValue = list(
functionName = "Image.clip",
arguments = list(
input = list(functionInvocationValue = list(
functionName = "ImageCollection.mosaic",
arguments = list(
collection = list(functionInvocationValue = list(
functionName = "ImageCollection.filterBounds",
arguments = list(
collection = list(functionInvocationValue = list(
functionName = "ImageCollection.load",
arguments = list(id = list(constantValue = "projects/meta-forest-monitoring-okw37/assets/CanopyHeight"))
)),
geometry = list(functionInvocationValue = list(
functionName = "GeometryConstructors.Rectangle",
arguments = list(coordinates = list(constantValue = conus), geodesic = list(constantValue = FALSE))
))
)
))
)
)),
geometry = list(functionInvocationValue = list(
functionName = "GeometryConstructors.Rectangle",
arguments = list(coordinates = list(constantValue = conus), geodesic = list(constantValue = FALSE))
))
)
)),
bands   = list(constantValue = list("b1")),
min     = list(constantValue = 0),
max     = list(constantValue = 30),
palette = list(constantValue = list("0A1F0A","2E6B2E","7DB87D","E8F4D0","FFFFFF"))
)
)
))
)
)
map_resp <- httr::POST(
paste0("https://earthengine.googleapis.com/v1/projects/", key$project_id, "/maps"),
httr::add_headers(Authorization = paste("Bearer", token)),
body = jsonlite::toJSON(body, auto_unbox = TRUE),
httr::content_type_json()
)
# Print status + response so we can see errors directly
print(httr::status_code(map_resp))
print(httr::content(map_resp))
map_name <- httr::content(map_resp)$name
paste0("https://earthengine.googleapis.com/v1/", map_name, "/tiles/{z}/{x}/{y}")
}
